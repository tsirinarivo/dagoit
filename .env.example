# ============================================================
# DAGO IT — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# App
NEXT_PUBLIC_SITE_URL=https://dago-it.com
NEXT_PUBLIC_APP_NAME="DAGO IT"

# Mode maintenance — "true" affiche la page /maintenance (HTTP 503) sur toutes
# les routes sauf /api/health et les assets. Enlever ou mettre "false" pour
# désactiver. Appliqué au démarrage du container (docker compose up -d
# --force-recreate suffit, pas besoin de rebuild).
MAINTENANCE_MODE=false

# Boutique en ligne — "false" cache tout le e-commerce (nav, cart, Footer,
# routes /boutique, /checkout, /api/erp/*) et redirige vers l'accueil.
# "true" (défaut) l'affiche normalement. Changement = REBUILD requis
# (NEXT_PUBLIC_ est inliné au build).
NEXT_PUBLIC_BOUTIQUE_ENABLED=true

# NexusERP (catalogue boutique + commandes — serveur uniquement, JAMAIS NEXT_PUBLIC_)
# ERP_CATALOG_ENABLED=false → boutique affiche les 5 produits en dur (lib/constants/products.ts)
# ERP_CATALOG_ENABLED=true  → boutique lit /api/v1/inventory depuis l'ERP
ERP_CATALOG_ENABLED=false
ERP_API_BASE=https://erp.dago-it.com
ERP_API_TOKEN=nxs_live_xxxxxxxxxxxxxxxxxxxx

# WhatsApp Business (numéro international sans +)
NEXT_PUBLIC_WHATSAPP_NUMBER=261320576777

# Analytics (optionnel)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
