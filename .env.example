# ============================================================
# DAGO IT — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# App
NEXT_PUBLIC_SITE_URL=https://dago-it.com
NEXT_PUBLIC_APP_NAME="DAGO IT"

# NexusERP (catalogue boutique + commandes — serveur uniquement, JAMAIS NEXT_PUBLIC_)
# ERP_CATALOG_ENABLED=false → boutique affiche les 5 produits en dur (lib/constants/products.ts)
# ERP_CATALOG_ENABLED=true  → boutique lit /api/v1/inventory depuis l'ERP
ERP_CATALOG_ENABLED=false
ERP_API_BASE=https://erp.dago-it.com
ERP_API_TOKEN=nxs_live_xxxxxxxxxxxxxxxxxxxx

# WooCommerce (site WordPress existant)
WOOCOMMERCE_URL=https://dago-it.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# Stripe (paiements CB)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Email (Resend ou SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@dago-it.com

# WhatsApp Business
NEXT_PUBLIC_WHATSAPP_NUMBER=+261340000000

# Payload CMS (si self-hosted)
PAYLOAD_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URI=mongodb://localhost:27017/dagoit

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=0000000

# Sanity (alternative à Payload)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=
